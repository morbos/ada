with "Ada_Drivers_Library/boards/stm32u3c5_bluepill.gpr";
with "Ada_Drivers_Library/boards/common_config.gpr";

project try_u3c5 extends "../../common.gpr" is

   for Languages use ("Ada");

   for Main use ("try_u3c5.adb");

   for Source_Dirs use ("src/**");

   for Object_Dir use "obj/" & Common_Config.Build;

   for Target use "arm-eabi";

   for Runtime ("Ada") use STM32U3C5_Bluepill'Runtime("Ada");

   package Builder is
     for Global_Configuration_Pragmas use "gnat.adc";
   end Builder;

end try_u3c5;
