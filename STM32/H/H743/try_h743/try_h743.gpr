with "Ada_Drivers_Library/boards/weact_h743.gpr";
with "Ada_Drivers_Library/boards/common_config.gpr";

project try_h743 extends "../../common.gpr" is

   for Languages use ("Ada");

   for Main use ("try_h743.adb");

   for Source_Dirs use ("src/**");

   for Object_Dir use "obj/" & Common_Config.Build;

   for Target use "arm-eabi";

   for Runtime ("Ada") use WeAct_H743'Runtime("Ada");

   package Builder is
     for Global_Configuration_Pragmas use "gnat.adc";
   end Builder;

end try_h743;
