type Volatile_UInt16 is new Interfaces.Unsigned_16
  with Volatile;

type CCR_Access is access all Volatile_UInt16;

procedure Update_CCR (CCR_Addr : System.Address; Value : Interfaces.Unsigned_16) is
   Reg : Volatile_UInt16 with Address => CCR_Addr;
begin
   Reg := Volatile_UInt16 (Value);
end Update_CCR;
