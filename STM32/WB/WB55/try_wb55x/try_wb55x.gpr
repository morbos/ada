with "Ada_Drivers_Library/boards/weact_wb55.gpr";
with "Ada_Drivers_Library/boards/common_config.gpr";

project try_wb55x extends "../../common.gpr" is

   for Languages use ("Ada");

   for Main use ("try_wb55x.adb");

   for Source_Dirs use ("src/**");

   for Object_Dir use "obj/" & Common_Config.Build;

   for Target use "arm-eabi";

   for Runtime ("Ada") use WeAct_WB55'Runtime("Ada");

   package Builder is
     for Global_Configuration_Pragmas use "gnat.adc";
   end Builder;

end try_wb55x;
